{
  "manifest_version": 3,
  "name": "Highlight Text",
  "version": "1.0",
  "description": "Highlight text on any website and save it locally.",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "index.html",
    "default_icon": "highlighter.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
